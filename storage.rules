rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ไฟล์นิยาย: อ่านได้ทุกคน, อัพโหลดได้เฉพาะ admin
    match /novels/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.email in [
          'momoppl01@gmail.com',
          'admin@memonster.com'
        ];
    }
  }
}
