rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // [SEC-3] สิทธิ์ admin มาจาก Firestore admins/{uid} เท่านั้น (ไม่มี email ฝังใน rules)
    function adminPath() {
      return /databases/(default)/documents/admins/$(request.auth.uid);
    }
    function isAdmin() {
      return request.auth != null
        && firestore.exists(adminPath())
        && firestore.get(adminPath()).data.get('active', true) != false;
    }

    function userPath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }
    function isMember() {
      return request.auth != null
        && firestore.exists(userPath())
        && firestore.get(userPath()).data.get('memberUntil', null) is timestamp
        && firestore.get(userPath()).data.get('memberUntil', null) > request.time;
    }

    // [SEC-4] จำกัดขนาด + ชนิดไฟล์
    function validUpload() {
      return request.resource.size < 100 * 1024 * 1024   // ไม่เกิน 100 MB
        && request.resource.contentType.matches('audio/.*|image/.*|application/pdf|text/plain');
    }

    // ไฟล์นิยาย: อ่านได้ทุกคน, เขียนได้เฉพาะ admin และไฟล์ต้องผ่าน validation
    match /novels/{allPaths=**} {
      allow read: if true;
      // delete ไม่มี request.resource → ตรวจแค่สิทธิ์
      allow write: if isAdmin() && (request.method == 'delete' || validUpload());
    }

    // รูป QR รับโอน: อ่านได้ทุกคน, เขียนได้เฉพาะ admin
    match /membership/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.method == 'delete' || validUpload());
    }

    // ไฟล์เสียงเฉพาะสมาชิก: อ่านได้เฉพาะ admin/สมาชิกที่ยังไม่หมดอายุ
    match /audio-premium/{allPaths=**} {
      allow read: if isAdmin() || isMember();
      allow write: if isAdmin() && (request.method == 'delete' || validUpload());
    }
  }
}
