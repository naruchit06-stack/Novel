rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: เช็คว่าเป็น admin (super admin email หรืออยู่ใน admins collection)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in ['momoppl01@gmail.com', 'admin@memonster.com'] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // นิยาย: ทุกคนอ่านได้, admin เท่านั้นที่เขียนได้
    match /novels/{novelId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      // ตอน: ทุกคนอ่านได้, admin เท่านั้นที่เขียนได้
      match /episodes/{episodeId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    // Admins collection: super admin อ่านได้, เขียนได้เฉพาะ super admin
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if request.auth != null &&
        request.auth.token.email in ['momoppl01@gmail.com', 'admin@memonster.com'];
    }

    // Users: เจ้าของเท่านั้นอ่าน/เขียนได้
    match /users/{userId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == userId;
    }
  }
}
