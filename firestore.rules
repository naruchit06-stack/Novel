rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ============================================================
       [SEC-3] ไม่มี email admin ฝังใน rules อีกต่อไป
       สิทธิ์ admin มาจากเอกสาร admins/{uid} เท่านั้น

       ⚠️ ตั้งค่าครั้งแรก (ทำใน Firebase Console เท่านั้น เพราะ rules
          ไม่ให้ใครเขียน admins ก่อนจะมี super admin):
          สร้างเอกสาร  admins/{UID ของคุณ}
            { role: "super", superAdmin: true, active: true,
              email: "...", displayName: "..." }
       ============================================================ */

    function isSignedIn() {
      return request.auth != null;
    }

    function adminPath() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    // เป็น admin = มีเอกสาร admins/{uid} และไม่ได้ถูกปิด (active ไม่ใช่ false)
    function isAdmin() {
      return isSignedIn()
        && exists(adminPath())
        && get(adminPath()).data.get('active', true) != false;
    }

    // super admin = admin ที่มี role == "super" หรือ superAdmin == true
    function isSuperAdmin() {
      return isAdmin()
        && (get(adminPath()).data.get('role', '') == 'super'
            || get(adminPath()).data.get('superAdmin', false) == true);
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function membershipPath() {
      return /databases/$(database)/documents/settings/membership;
    }

    // สมาชิก = users/{uid}.memberUntil เป็น timestamp และยังไม่หมดอายุ
    function isMember() {
      return isSignedIn()
        && exists(userPath())
        && get(userPath()).data.get('memberUntil', null) is timestamp
        && get(userPath()).data.get('memberUntil', null) > request.time;
    }

    // สวิตช์ระบบสมาชิกปิดอยู่ = เปิดทุกตอนให้ทุกคน
    function membershipOpen() {
      return !exists(membershipPath())
        || get(membershipPath()).data.get('enabled', false) != true;
    }

    /* ---------- Validation helpers ---------- */

    function isStr(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }
    function isNonNegInt(v) {
      return v is int && v >= 0;
    }
    function isHttpUrl(v) {
      return v is string
        && v.size() <= 2048
        && (v.matches('https://.*') || v.matches('http://.*'));
    }

    // นิยาย — ตรวจชนิด/ขนาดข้อมูลก่อนเขียน
    function validNovel(d) {
      return d.keys().hasOnly([
               'title','author','description','desc','synopsis','coverUrl',
               'status','tags','episodeCount','views','likes','rating',
               'emoji','releaseSchedule','createdAt','updatedAt'
             ])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && (!('author' in d)        || isStr(d.author, 120))
        && (!('description' in d)   || isStr(d.description, 5000))
        && (!('desc' in d)          || isStr(d.desc, 5000))
        && (!('synopsis' in d)      || isStr(d.synopsis, 5000))
        && (!('coverUrl' in d)      || d.coverUrl == '' || isHttpUrl(d.coverUrl))
        && (!('status' in d)        || d.status in
              ['ongoing','done','new','hiatus','completed','pending'])
        && (!('tags' in d)          || (d.tags is list && d.tags.size() <= 20))
        && (!('episodeCount' in d)  || (isNonNegInt(d.episodeCount) && d.episodeCount <= 100000))
        && (!('views' in d)         || isNonNegInt(d.views))
        && (!('likes' in d)         || isNonNegInt(d.likes))
        && (!('rating' in d)        || (d.rating is number && d.rating >= 0 && d.rating <= 10))
        && (!('emoji' in d)         || isStr(d.emoji, 16))
        && (!('releaseSchedule' in d) || isStr(d.releaseSchedule, 200));
    }

    // ตอน — ตรวจชนิด/ขนาดข้อมูลก่อนเขียน
    function validEpisode(d) {
      return d.keys().hasOnly([
               'title','order','audioUrl','audioKey','fileName','duration',
               'createdAt','updatedAt','isFree','locked','premium'
             ])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && (d.order is int || d.order is string)
        && (!('audioUrl' in d) || d.audioUrl == null || d.audioUrl == '' || isHttpUrl(d.audioUrl))
        && (!('audioKey' in d) || d.audioKey == null
              || (d.audioKey is string && d.audioKey.size() > 0 && d.audioKey.size() <= 400
                  && d.audioKey.matches('audio/[A-Za-z0-9._/-]+')))
        && (!('fileName' in d) || isStr(d.fileName, 300))
        && (!('duration' in d) || (d.duration is number && d.duration >= 0))
        && (!('premium' in d)  || d.premium is bool);
    }

    function validPaymentRequest(d) {
      return d.keys().hasOnly(['uid','name','email','amount','note','status','createdAt'])
        && d.uid is string
        && d.uid.size() > 0 && d.uid.size() <= 128
        && d.status == 'pending'
        && d.amount is number && d.amount > 0 && d.amount <= 100000
        && (!('name' in d)  || isStr(d.name, 120))
        && (!('email' in d) || isStr(d.email, 200))
        && (!('note' in d)  || isStr(d.note, 500));
    }

    /* ---------- นิยาย ---------- */
    match /novels/{novelId} {
      allow read: if true;
      allow create, update: if isAdmin() && validNovel(request.resource.data);
      allow delete: if isAdmin();

      /* ---------- ตอน ---------- */
      match /episodes/{episodeId} {
        allow read: if membershipOpen()
          || isAdmin()
          || isMember()
          || resource.data.keys().hasAny(['premium']) == false
          || resource.data.premium == false;
        allow create, update: if isAdmin() && validEpisode(request.resource.data);
        allow delete: if isAdmin();
      }
    }

    /* ---------- Admins ---------- */
    match /admins/{adminId} {
      // admin อ่านรายชื่อได้, super admin เท่านั้นที่เขียนได้
      allow read:  if isAdmin();
      allow write: if isSuperAdmin();
    }

    /* ---------- Settings (hero image, membership ฯลฯ) ---------- */
    match /settings/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    /* ---------- Users ---------- */
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow read: if isAdmin();

      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
             'uid','email','displayName','photoURL','role',
             'lastLogin','createdAt'
           ]);

      allow update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'uid','email','displayName','photoURL','role',
             'lastLogin','createdAt'
           ]);

      allow update: if isAdmin();
      allow delete: if isAdmin();

      // subcollections: history, epProgress ฯลฯ
      match /{document=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    /* ---------- Payment requests ---------- */
    match /paymentRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && validPaymentRequest(request.resource.data);

      allow read: if isAdmin();
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;

      allow update, delete: if isAdmin();
    }
  }
}
